{
  "name": "agenthub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "demo": "vite --mode demo",
    "screenshots": "playwright test --config playwright.config.ts",
    "screenshots:install": "playwright install chromium",
    "screenshots:gif": "node scripts/create-demo-gif.mjs",
    "screenshots:all": "npm run screenshots && npm run screenshots:gif",
    "website:dev": "npm --prefix website run dev",
    "website:build": "npm --prefix website run build",
    "build": "tsc && vite build",
    "test": "vitest run --coverage",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tauri-apps/cli": "^2.9.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^25.0.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
